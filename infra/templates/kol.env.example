COMPOSE_PROJECT_NAME=kol-staging
HTTP_PORT=13001
KOL_IMAGE=kol-realms:infra-009
DB_MEMORY=512m
API_MEMORY=256m
APP_UID=10002
APP_GID=10002
DB_NAME=kol_staging

# API binds to 0.0.0.0 only inside its container; host publication stays loopback.
# Credentials are individual files in ./secrets, outside the repository.
# Cache availability is optional for readiness; PostgreSQL/schema/roles are required.

# Scheduling policy is persisted through the admin tool, never seeded from fixtures.
# No gameplay schedule is enabled by deployment. Bounded accounts per batch:
SCHEDULER_BATCH=50

# Process-local API peer budget; durable authentication throttles remain separate.
API_REQUESTS_PER_MINUTE=120

# Set only by the checked storage relocation; omit for an ordinary Docker volume.
# DB_VOLUME_NAME=realms_kol_staging_database
