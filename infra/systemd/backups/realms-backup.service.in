[Unit]
Description=Encrypted Realms USB backup
Requires=docker.service
After=docker.service kol-postgresql.service
RequiresMountsFor=/mnt/Realms-backups
OnFailure=realms-backup-failure.service
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /srv/Realms/source/infra/scripts/local-backups.py run
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=2G
CPUQuota=50%
TimeoutStartSec=2h
TimeoutStopSec=2min
