    {
      "definition": {
        "dependencies": [],
        "name": "Marsh wardens",
        "public": {
          "description": "The local crossing keepers."
        }
      },
      "id": "faction.marsh-wardens",
      "kind": "FACTION",
      "revision": 1,
      "schemaVersion": 1
    },
    {
      "definition": {
        "dependencies": [
          "location.sluice-office",
          "faction.marsh-wardens",
          "quest.marsh-road",
          "activity.sluice"
        ],
        "mechanics": {
          "npcDialogue": {
            "accountMemoryApproval": null,
            "affiliations": [
              "faction.marsh-wardens"
            ],
            "attributes": {
              "background": "A local keeper charged with maintaining the marsh crossing.",
              "boundaries": "Will not invent rewards, promise faction authority, or claim knowledge of earlier lives.",
              "motives": "Keep the crossing safe.",
              "personality": "Practical, patient and wry. Their humor is about maintenance, not a copy of the narrator.",
              "values": "Useful work and honest reports."
            },
            "locationId": "location.sluice-office",
            "nodes": [
              {
                "choices": [
                  {
                    "aliases": [
                      "hello",
                      "hi",
                      "greetings",
                      "tell me about yourself"
                    ],
                    "consequence": "The keeper remembers this conversation in the current life. No reward or quest outcome is granted.",
                    "handoff": null,
                    "id": "hello",
                    "label": "Introduce yourself",
                    "memory": {
                      "id": "memory.hello",
                      "scope": "RUN",
                      "text": "The keeper and you discussed introduce yourself."
                    },
                    "requires": [],
                    "response": "I keep the sluice. The sluice keeps finding reasons to require a keeper. I see no end to either arrangement.",
                    "to": "greeting"
                  },
                  {
                    "aliases": [
                      "the road",
                      "marsh road",
                      "tell me about the road"
                    ],
                    "consequence": "The keeper remembers this conversation in the current life. No reward or quest outcome is granted.",
                    "handoff": {
                      "id": "quest.marsh-road",
                      "kind": "QUEST"
                    },
                    "id": "road",
                    "label": "Ask about the marsh road",
                    "memory": {
                      "id": "memory.road",
                      "scope": "RUN",
                      "text": "The keeper and you discussed ask about the marsh road."
                    },
                    "requires": [],
                    "response": "The road is flooded. There is a lever by the gate; it has been waiting years for someone with more curiosity than sense.",
                    "to": "greeting"
                  },
                  {
                    "aliases": [
                      "I opened the sluice",
                      "the sluice is open"
                    ],
                    "consequence": "The keeper remembers this conversation in the current life. No reward or quest outcome is granted.",
                    "handoff": {
                      "id": "quest.marsh-road",
                      "kind": "QUEST"
                    },
                    "id": "report",
                    "label": "Report the open sluice",
                    "memory": {
                      "id": "memory.sluice",
                      "scope": "RUN",
                      "text": "You opened the sluice and told the keeper. The report is backed by your committed encounter."
                    },
                    "requires": [
                      {
                        "id": "activity.sluice",
                        "kind": "OBSTACLE",
                        "outcome": "RESOLVED"
                      }
                    ],
                    "response": "You opened it. Good. I was beginning to think the lever was a purely decorative threat.",
                    "to": "greeting"
                  },
                  {
                    "aliases": [
                      "reeds"
                    ],
                    "consequence": "The keeper remembers this conversation in the current life. No reward or quest outcome is granted.",
                    "handoff": null,
                    "id": "reeds",
                    "label": "Report the broken mechanism",
                    "memory": {
                      "id": "memory.reeds",
                      "scope": "RUN",
                      "text": "The keeper knows the mechanism failed and you found another route."
                    },
                    "requires": [
                      {
                        "id": "activity.sluice",
                        "kind": "OBSTACLE",
                        "outcome": "FAILED_FORWARD"
                      }
                    ],
                    "response": "The reeds will have to do. A road need not be elegant; it merely has to continue being underneath you.",
                    "to": "greeting"
                  },
                  {
                    "aliases": [
                      "inspect sluice",
                      "the road"
                    ],
                    "consequence": "The keeper remembers this conversation in the current life. No reward or quest outcome is granted.",
                    "handoff": {
                      "id": "activity.sluice",
                      "kind": "OBSTACLE"
                    },
                    "id": "lever",
                    "label": "Inspect the sluice approaches",
                    "memory": {
                      "id": "memory.lever",
                      "scope": "RUN",
                      "text": "The keeper and you discussed inspect the sluice approaches."
                    },
                    "requires": [],
                    "response": "Look at the gate before touching anything. We tried the other order. It was educational.",
                    "to": "greeting"
                  }
                ],
                "id": "greeting",
                "recall": [
                  {
                    "memoryId": "memory.sluice",
                    "text": "Back again? The crossing is still open. For once, I am pleased to have nothing interesting to report."
                  },
                  {
                    "memoryId": "memory.reeds",
                    "text": "The reed path is holding. The mechanism is not. I have recorded both facts in the appropriate tone."
                  }
                ],
                "text": "Mind the step. The floor is dry because the water has found more ambitious places to be."
              }
