{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "client/**/*.ts",
    "scripts/client-preview.ts", "scripts/shell-preview.ts", "scripts/welcome-preview.ts",
    "scripts/advancement-preview.ts", "scripts/character-book-preview.ts"
  ]
}
