  "approved_corrections": [
    {
      "topic": "PvP / gambling",
      "earlier_direction": "Earlier PvP planning did not treat wagering as a core feature and prior caps/limits were contemplated.",
      "canonical_resolution": "System 39 authorizes eligible Gold wagering including player-versus-player wagering with a mandatory humorous risk tutorial, escrow and heavy anti-laundering/collusion controls. System 40 additionally permits explicit card-for-card stakes for eligible tradable cards. Legal/platform eligibility still gates deployment.",
      "owner": "39 / 40"
    },
    {
      "topic": "Culture selection",
      "earlier_direction": "Earlier species/culture language could imply a formal player culture choice.",
      "canonical_resolution": "System 37 removes a separate culture-selection subsystem. Cultures exist in the world and can be reflected narratively, but players do not manage a culture build layer.",
      "owner": "37"
    },
    {
      "topic": "Backgrounds / origins",
      "earlier_direction": "Core already rejected a formal D&D-style Background system.",
      "canonical_resolution": "System 37 confirms optional narrative origins/backstory only, with no standardized mechanical progression package.",
      "owner": "37"
    },
    {
      "topic": "Languages",
      "earlier_direction": "Potentially deeper language proficiency play.",
      "canonical_resolution": "System 37 simplifies language handling. Languages can matter contextually without becoming a complex character-management subsystem.",
      "owner": "37"
    },
    {
      "topic": "Wilderness Trek / camps",
      "earlier_direction": "Initial System 33 proposal suggested named multi-stage Wilderness Treks and temporary field camps.",
      "canonical_resolution": "Rejected. Travel remains quick-to-instant; wilderness exploration is optional play in the existing world. No dedicated temporary field-camp system.",
      "owner": "33"
    },
    {
      "topic": "Investigation depth",
      "earlier_direction": "Initial System 38 framing proposed more formal case files, theory graphs, and multiplayer investigation.",
      "canonical_resolution": "Simplified. Investigation is normal RPG/quest gameplay with optional deeper mysteries, not a detective simulator; no dedicated multiplayer investigation subsystem.",
      "owner": "38"
    },
    {
      "topic": "Subclass roster",
      "earlier_direction": "System 43 offered three example lanes per class.",
      "canonical_resolution": "Only the 12 base classes are locked for now. Subclass roster, names and exact packages remain future content design.",
      "owner": "43"
    },
    {
      "topic": "Ascension lore",
      "earlier_direction": "A stronger “explicitly real reincarnation system” framing was proposed.",
      "canonical_resolution": "System 44 makes the connection loose and mysterious. Most people do not know or understand Ascension; rare entities may perceive echoes. It can remain a long-term mystery indefinitely.",
      "owner": "44"
    },
    {
      "topic": "Campaign ending",
      "earlier_direction": "Open-ended continuation was possible.",
      "canonical_resolution": "System 44 locks a real conclusion to the launch campaign’s immediate central crisis while leaving wider mysteries and future expansion hooks open.",
      "owner": "44"
    },
    {
      "topic": "Procedural dungeon rooms",
      "earlier_direction": "Landmark-room hybrid proposed.",
      "canonical_resolution": "System 32 additionally requires themed random filler rooms for immersion, pacing, believable architecture and surprises.",
      "owner": "32"
    },
    {
      "topic": "Long-tail scaling",
      "earlier_direction": "Aftercore emphasized diminished vertical growth.",
      "canonical_resolution": "System 45 clarifies that damage/survivability can continue increasing every level through 999, but on controlled diminishing curves; declared challenge systems scale appropriately without hidden universal enemy mirroring.",
      "owner": "45"
    },
    {
      "topic": "Gear power",
      "earlier_direction": "Character/build power was emphasized over equipment.",
      "canonical_resolution": "System 45 clarifies gear is also a major power source and exceptional gear can substantially outperform ordinary gear while build coherence still matters.",
      "owner": "45"
    }
  ],
  "subfeature_overrides": [
    "System 39: taverns and ordinary recreational activities may be Launch Supporting; high-stakes wagering should remain feature-gated by legal/platform eligibility and operational readiness.",
    "System 42: ordinary bosses are Launch Core; full server-wide world-boss campaigns may be Post-Launch Ready.",
    "System 13/32: meaningful Aftercore and at least one Expedition-style endgame loop are Launch Core; extreme endless-depth breadth can grow later.",
    "System 22: PvP architecture is planned from the beginning, but mature ranked/async formats can launch later.",
    "System 40: the card-game integration points can exist at launch while the full card ecosystem remains Post-Launch Ready if schedule demands.",
    "System 15: event framework should be architected before launch, but large live-event cadence begins only when operations can support it safely."
  ],
